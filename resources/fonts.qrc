<RCC>
    <qresource prefix="/fonts">
        <file alias="JetBrainsMonoNL-Regular.ttf">fonts/JetBrainsMonoNL-Regular.ttf</file>
        <file alias="JetBrainsMonoNL-Medium.ttf">fonts/JetBrainsMonoNL-Medium.ttf</file>
        <file alias="JetBrainsMonoNL-SemiBold.ttf">fonts/JetBrainsMonoNL-SemiBold.ttf</file>
        <file alias="JetBrainsMonoNL-Bold.ttf">fonts/JetBrainsMonoNL-Bold.ttf</file>
        <file alias="JetBrainsMonoNL-Italic.ttf">fonts/JetBrainsMonoNL-Italic.ttf</file>
        <file alias="JetBrainsMonoNL-BoldItalic.ttf">fonts/JetBrainsMonoNL-BoldItalic.ttf</file>
    </qresource>
</RCC>
